# Migratrix environment template.
# The installer copies this to .env (if .env is missing) and then fills in
# AGENT_HOST and MIGRATRIX_API_KEY for you.

# Application Configuration
APP_NAME=Migratrix
APP_VERSION=1.0.0

# Logging Configuration
LOGGING_LEVEL=Information

# Security Configuration
CORS_ORIGINS=https://app.migratrix.com,http://app.migratrix.com

# API Configuration
API_BASE_URL=https://app.migratrix.com/api

# SSL/TLS Configuration
SSL_ENABLED=true
FORCE_HTTPS=false

# Rate Limiting
API_RATE_LIMIT=10
WEB_RATE_LIMIT=30

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_RETRIES=3

# Docker Configuration
COMPOSE_PROJECT_NAME=migratrix
REGISTRY=ghcr.io/migratrix/
TAG=latest

# Published ports (host side)
AGENT_PORT=4002
HTTPS_PORT=443
DASHBOARD_PORT=8080

# Hostname Traefik serves the agent on (set by the installer via --host)
AGENT_HOST=agent.localhost

# Agent API Key — generate from Account Settings → API Key (set by the installer via --api-key)
MIGRATRIX_API_KEY=

# The orchestrator the agent (and the Risk API) connects to (set by the installer via --orchestrator-url).
# Sign-in tokens are validated with the public keys it publishes at <url>/.well-known/jwks.json; no
# signing key is shared with the agent. Leave unset for Migratrix SaaS.
# MIGRATRIX_ORCHESTRATOR_URL=https://api.migratrix.com

# Risk Assessment push webhooks. The installer generates the GitHub secret when it is empty; enter the same
# value as the Secret of the repository's GitHub webhook (URL https://<AGENT_HOST>/webhooks/github, push events).
# Left empty, the webhook endpoints answer 503 and repositories are reindexed only when someone indexes them.
MIGRATRIX_GITHUB_WEBHOOK_SECRET=
MIGRATRIX_GITLAB_WEBHOOK_TOKEN=

# The origin of your own Platform (on-prem), e.g. https://migratrix.example.com, so the Risk page may call the
# Risk Assessment API. Leave empty for Migratrix SaaS.
MIGRATRIX_PLATFORM_ORIGIN=

ASPNETCORE_ENVIRONMENT=Production
