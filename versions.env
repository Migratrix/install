# The released set of Migratrix images: the image tags the installer writes into .env.
#
# Every value is a version X.Y.Z, each image on its own line of versions. "latest" is refused by
# publish-install.sh and by the installers.
#
# Filled by installer/set-versions.sh before the installer is published; published next to SHA256SUMS, which
# covers it. The Platform reads AGENT_TAG from the published copy to tell a Docker agent that a newer release
# exists.
AGENT_TAG=1.0.0
RISK_TAG=1.0.3
SQLGLOT_TAG=1.0.0
JAVA_ANALYZER_TAG=1.0.0
PYTHON_ANALYZER_TAG=1.0.0
