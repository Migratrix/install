# The released set of Migratrix images: the image tags the installer writes into .env.
#
# Every value is a tag that is never moved: a version X.Y.Z, or the commit the image was built from (the two
# analyzers, which are built in their own repositories). "latest" is refused by publish-install.sh and by the
# installers.
#
# Filled by installer/set-versions.sh before the installer is published; published next to SHA256SUMS, which
# covers it. The Platform reads AGENT_TAG from the published copy to tell a Docker agent that a newer release
# exists.
AGENT_TAG=1.1.120
RISK_TAG=1.0.15
SQLGLOT_TAG=1.0.3
JAVA_ANALYZER_TAG=47e65b262ad2822156367097ddd582b385457eb8
PYTHON_ANALYZER_TAG=4f1af344e5750a64158d138352a6cc18050f0dd4
